# 环境变量样例。复制成 .env 使用（.env 已被 .gitignore 排除，绝不入库）。
#
# 服务端配置（本文件里的变量都是可选的，缺省值见 README）
# BASE_PATH=/dinner
# PORT=8787
# HOST=0.0.0.0
# DB_PATH=data/dinner.db
# WEB_DIST_DIR=web/dist
# DEV_API_PORT=8788

# LLM 端点（OpenAI 兼容）。真实 key 只写进 .env，不要写进本文件。
# 不配这两项时功能照常，只把「给我推荐」降级成简化推荐（规则直接拼，界面显著标记）。
# OPENAI_BASE_URL=http://127.0.0.1:8004/codebuddy/v1
# OPENAI_API_KEY=
# LLM_MODEL=deepseek-v4.1-flash

# LLM 的完整请求/响应只在 DEBUG=1 时落到 data/logs/（排查推荐效果用；其中不含 key）。
# DEBUG=1
